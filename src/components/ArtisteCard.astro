---
import { getImageUrl } from "../../backend/backend.mjs";
import FloatingLabelCard from "./FloatingLabelCard.astro";

const { artiste, representation } = Astro.props;

const nom = artiste?.nom ?? "Artiste";
const photo = artiste?.photo_principale ?? null;
const photoSrc = photo ? getImageUrl(artiste, photo) : null;
---

<FloatingLabelCard
	href={`/artistes/${artiste.id}`}
	imageSrc={photoSrc}
	imageAlt={`Photo de ${nom}`}
	label={nom}
	aspectClass="aspect-[16/10]"
	labelAlign="end"
	labelWidthClass="min-w-[128px] justify-center"
/>
