---
import { getImageUrl } from "../../backend/backend.mjs";

const { scene } = Astro.props;

const nom = scene?.nom ?? "Scène";
const photo = scene?.photo ?? null;
---

<article
    class="overflow-hidden border border-[var(--light-v)] bg-white/5 transition hover:bg-white/10"
>
    <a href={`/scenes/${scene.id}`} class="block h-full">
        {
            photo ? (
                <img
                    src={getImageUrl(scene, photo)}
                    alt={`Photo de ${nom}`}
                    class="aspect-[4/3] w-full object-cover"
                />
            ) : (
                <div class="flex aspect-[4/3] w-full items-center justify-center bg-white/5 text-center">
                    Aucune image
                </div>
            )
        }

        <div class="p-4">
            <h2 class="text-4xl leading-none md:text-5xl">{nom}</h2>
        </div>
    </a>
</article>
