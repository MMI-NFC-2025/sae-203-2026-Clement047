---
import { getImageUrl } from "../../backend/backend.mjs";
import FloatingLabelCard from "./FloatingLabelCard.astro";

const { scene } = Astro.props;

const nom = scene?.nom ?? "Scène";
const photo = scene?.photo ?? null;
const photoSrc = photo ? getImageUrl(scene, photo) : null;
---

<FloatingLabelCard
	href={`/scenes/${scene.id}`}
	imageSrc={photoSrc}
	imageAlt={`Photo de ${nom}`}
	label={nom}
	aspectClass="aspect-[16/10]"
	labelAlign="end"
	labelWidthClass="min-w-[180px] justify-center"
/>
