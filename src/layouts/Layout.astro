---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "Chorus Symphonia", fullScreen = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Chorus Symphonia : festival de musique classique à la Citadelle de Besançon."
		/>
		<title>{title}</title>

		<link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />

		<link
			href="https://fonts.googleapis.com/css2?family=Mohave:wght@300;400;700&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body
		class="min-h-screen overflow-x-hidden bg-[var(--v-dark)] text-[var(--light-v)]"
	>
		<Header />

		<main class:list={["overflow-x-hidden", fullScreen ? "" : "pt-24"]}>
			<slot />
		</main>

		<Footer />
	</body>
</html>
