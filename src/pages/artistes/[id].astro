---
import Layout from "../../layouts/Layout.astro";
import {
    getArtisteById,
    getArtistesByDate,
    getImageUrl,
} from "../../../backend/backend.mjs";

const { id } = Astro.params;

const artiste = await getArtisteById(id);
const representations = await getArtistesByDate();

const artisteRepresentations = representations.filter(
    (rep) => rep.expand?.artiste?.id === id,
);

const photo = artiste?.photo_principale ?? null;
const galerie = artiste?.galerie_photo ?? [];
---

<Layout title={`${artiste?.nom ?? "Artiste"} - Chorus Symphonia`}>
    {
        artiste ? (
            <>
                <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
                    <h1 class="mb-4 text-5xl md:text-7xl">{artiste.nom}</h1>
                    <p class="mx-auto max-w-2xl text-lg md:text-xl">
                        {artiste.genre_musical ?? "Genre non renseigné"}
                    </p>
                </section>

                <section class="mx-auto grid max-w-6xl gap-8 px-6 pb-12 md:grid-cols-2">
                    <div>
                        {photo ? (
                            <img
                                src={getImageUrl(artiste, photo)}
                                alt={`Photo de ${artiste.nom}`}
                                class="aspect-[4/5] w-full border border-[var(--light-v)] object-cover"
                            />
                        ) : (
                            <div class="flex aspect-[4/5] w-full items-center justify-center border border-[var(--light-v)] bg-white/5 text-center">
                                Aucune image disponible
                            </div>
                        )}
                    </div>

                    <div>
                        <h2 class="mb-4 text-4xl md:text-5xl">Présentation</h2>

                        <div
                            class="mb-8 space-y-4"
                            set:html={
                                artiste.description ??
                                "<p>Aucune description disponible.</p>"
                            }
                        />

                        <h2 class="mb-4 text-4xl md:text-5xl">
                            Au programme du festival
                        </h2>

                        {artisteRepresentations.length > 0 ? (
                            <ul class="mb-8 list-disc space-y-3 pl-5">
                                {artisteRepresentations.map((rep) => (
                                    <li>
                                        <strong>
                                            {rep.date_representation
                                                ?.slice(0, 10)
                                                .split("-")
                                                .reverse()
                                                .join("/")}
                                        </strong>
                                        {rep.heure_representation
                                            ? ` • ${rep.heure_representation}`
                                            : ""}
                                        {rep.expand?.scene?.nom
                                            ? ` • ${rep.expand.scene.nom}`
                                            : ""}
                                    </li>
                                ))}
                            </ul>
                        ) : (
                            <p class="mb-8">Aucune représentation trouvée.</p>
                        )}

                        <a
                            href="/artistes"
                            class="inline-block border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                        >
                            ← Retour aux artistes
                        </a>
                    </div>
                </section>

                {galerie.length > 0 && (
                    <section class="mx-auto max-w-6xl px-6 pb-16">
                        <h2 class="mb-6 text-4xl md:text-5xl">Galerie</h2>

                        <div class="grid gap-4 md:grid-cols-2">
                            {galerie.map((image) => (
                                <img
                                    src={getImageUrl(artiste, image)}
                                    alt={`Galerie de ${artiste.nom}`}
                                    class="aspect-[4/3] w-full border border-[var(--light-v)] object-cover"
                                />
                            ))}
                        </div>
                    </section>
                )}
            </>
        ) : (
            <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
                <h1 class="mb-4 text-5xl md:text-7xl">Artiste introuvable</h1>
                <p class="mx-auto max-w-2xl text-lg md:text-xl">
                    Cet artiste n’existe pas ou n’est plus disponible.
                </p>
            </section>
        )
    }
</Layout>
