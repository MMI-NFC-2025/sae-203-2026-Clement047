---
import Layout from "../../layouts/Layout.astro";
import Carousel from "../../components/Carousel.astro";
import {
    getArtisteById,
    getArtistesByDate,
    getImageUrl,
} from "../../../backend/backend.mjs";

const { id } = Astro.params;

const artiste = id ? await getArtisteById(id) : null;
const representations = await getArtistesByDate();

const artisteRepresentations = representations.filter(
    (rep) => rep.expand?.artiste?.id === id,
);

const photo = artiste?.photo_principale ?? null;
const galerie = artiste?.galerie_photo ?? [];
const photoSrc = artiste && photo ? getImageUrl(artiste, photo) : null;
const galerieImages = artiste
    ? galerie.map((image: string) => ({
          src: getImageUrl(artiste, image),
          alt: `Galerie de ${artiste.nom}`,
      }))
    : [];

const formatRepresentationDate = (value: string | Date | null | undefined) => {
    if (!value) return "Date non renseignée";

    return new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(new Date(value));
};
---

<Layout title={`${artiste?.nom ?? "Artiste"} - Chorus Symphonia`} fullScreen={true}>
    {
        artiste ? (
            <>
                <section class="relative left-1/2 w-screen -translate-x-1/2 pt-0">
                    <div class="relative w-full overflow-visible">
                        <div class="relative h-[38vh] min-h-[300px] w-full overflow-hidden border-y border-[var(--light-v)] md:h-[52vh] md:min-h-[520px] md:max-h-[720px]">
                            {
                                photoSrc ? (
                                    <img
                                        src={photoSrc}
                                        alt={`Photo principale de ${artiste.nom}`}
                                        class="absolute inset-0 h-full w-full object-cover object-center scale-[1.12] md:scale-[1.16]"
                                    />
                                ) : (
                                    <div class="absolute inset-0 bg-white/5"></div>
                                )
                            }
                            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--v-dark)]/12"></div>
                            <div class="absolute inset-x-0 bottom-0 border-b border-[var(--light-v)]/85"></div>
                        </div>

                        <div class="pointer-events-none absolute bottom-0 left-0 z-20 translate-y-[62%] px-6 md:translate-y-[56%] md:px-10">
                            <div class="bg-[var(--v-dark)] pr-4 pt-2 md:pr-6 md:pt-3">
                                <h1 class="max-w-[340px] text-[64px] font-normal leading-[0.88] tracking-[-0.04em] text-[var(--vi)] md:max-w-[760px] md:text-[124px]">
                                    {artiste.nom}
                                </h1>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="relative z-20 mx-auto w-full max-w-6xl overflow-visible px-5 pb-8 pt-[126px] sm:px-6 md:px-10 md:pb-10 md:pt-[170px]">
                    <h2 class="max-w-[44rem] text-[24px] font-normal leading-[1.02] text-[var(--light-v)] sm:text-[26px] md:max-w-[760px] md:text-[48px] md:leading-[1.04]">
                        {artiste.genre_musical ?? "Artiste invité"}
                    </h2>
                </section>

                <section class="mx-auto w-full max-w-6xl px-5 pb-12 sm:px-6 md:px-10 md:pb-16">
                    <div class="relative md:max-w-[860px]">
                        <div
                            class="max-w-[46rem] text-[18px] leading-[1.55] text-[var(--light-v)]/92 sm:text-[19px] md:max-w-[760px] md:text-[28px] md:leading-[1.5] [&_p]:mb-5 [&_a]:text-[var(--vi)]"
                            set:html={
                                artiste.description ??
                                "<p>Aucune description disponible.</p>"
                            }
                        />

                        <img
                            src="/icons/etoile3.svg"
                            alt=""
                            aria-hidden="true"
                            class="absolute bottom-[-10px] right-2 hidden h-[86px] w-10 sm:block md:bottom-0 md:right-10 md:h-[112px] md:w-14"
                        />
                    </div>
                </section>

                <section class="mx-auto w-full max-w-6xl px-5 pb-14 sm:px-6 md:px-10 md:pb-18">
                    <div class="max-w-[54rem] md:max-w-[860px]">
                        <h2 class="text-[28px] font-normal leading-none text-[var(--light-v)] md:text-[42px]">
                            Au Programme du Festival
                        </h2>

                        {artisteRepresentations.length > 0 ? (
                            <div class="mt-8 space-y-6 md:mt-10 md:space-y-8">
                                {artisteRepresentations.map((rep) => (
                                    <article class="border border-[var(--light-v)] bg-white/5 p-6 md:p-8">
                                        <p class="text-[19px] leading-[1.45] text-[var(--vi)] md:text-[28px]">
                                            {formatRepresentationDate(rep.date_representation)}
                                            <br />
                                            {rep.expand?.scene?.nom ?? "Scène non renseignée"}
                                        </p>

                                        <p class="mt-8 text-[19px] leading-[1.45] text-[var(--vi)] md:text-[28px]">
                                            {rep.heure_representation ?? "Horaire non renseigné"}
                                            {rep.expand?.scene?.nom
                                                ? ` • ${rep.expand.scene.nom}`
                                                : ""}
                                        </p>

                                        <p class="mt-8 text-[19px] leading-[1.55] text-[var(--light-v)]/92 md:text-[28px] md:leading-[1.5]">
                                            {artiste.nom}, {artiste.genre_musical ?? "artiste"}
                                        </p>
                                    </article>
                                ))}
                            </div>
                        ) : (
                            <p class="mt-8 text-[19px] leading-[1.55] text-[var(--light-v)]/92 md:text-[28px] md:leading-[1.5]">
                                Aucune représentation trouvée.
                            </p>
                        )}

                        <a
                            href="/artistes"
                            class="mt-10 inline-block border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)] md:mt-12"
                        >
                            ← Retour aux artistes
                        </a>
                    </div>
                </section>

                {galerieImages.length > 0 && (
                    <section class="mx-auto w-full max-w-6xl px-5 pb-20 sm:px-6 md:px-10 md:pb-24">
                        <h2 class="mb-6 text-[28px] font-normal leading-none text-[var(--light-v)] md:mb-8 md:text-[42px]">
                            Galerie
                        </h2>

                        <Carousel
                            images={galerieImages}
                            aspectClass="aspect-[16/10]"
                            altPrefix={`Galerie de ${artiste.nom}`}
                        />
                    </section>
                )}
            </>
        ) : (
            <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
                <h1 class="mb-4 text-5xl md:text-7xl">Artiste introuvable</h1>
                <p class="mx-auto max-w-2xl text-lg md:text-xl">
                    Cet artiste n’existe pas ou n’est plus disponible.
                </p>
            </section>
        )
    }
</Layout>