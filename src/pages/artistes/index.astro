---
import Layout from "../../layouts/Layout.astro";
import ArtisteCard from "../../components/ArtisteCard.astro";
import { getArtistesByDate } from "../../../backend/backend.mjs";

const representations = await getArtistesByDate();
---

<Layout title="Artistes - Chorus Symphonia" fullScreen={true}>
    <section class="relative isolate">
        <div class="relative h-[42svh] min-h-[300px] md:h-[620px]">
            <img
                src="/img/Artistes/imageheroartistes.avif"
                alt="Musicienne jouant de la harpe sur scène"
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[var(--v-dark)] to-transparent md:h-40"></div>
        </div>
    </section>

    <section class="relative z-20 mx-auto w-full max-w-6xl -mt-[66px] overflow-visible px-5 pb-10 pt-0 sm:px-6 md:-mt-[82px] md:px-10 md:pb-14">
        <h1 class="text-[clamp(3.2rem,15vw,5.25rem)] font-normal leading-[0.9] text-[var(--light-v)]">
            Artistes
        </h1>

        <h2 class="max-w-[22rem] pt-16 text-[clamp(2rem,10vw,3.75rem)] font-normal leading-[1.02] text-[var(--vi)] sm:max-w-[34rem] md:max-w-[760px] md:pt-28 md:leading-[64px]">
            Les Étoiles de Chorus
            <br />
            Symphonia
        </h2>
    </section>

    <section class="mx-auto w-full max-w-6xl px-5 pb-12 sm:px-6 md:px-10 md:pb-16">
        <div class="relative md:max-w-[860px]">
            <p class="max-w-[44rem] text-[18px] leading-[1.55] text-[var(--light-v)]/92 sm:text-[19px] md:max-w-[760px] md:text-[28px] md:leading-[1.5]">
                Plongez dans l'univers des talents qui feront vibrer la Citadelle de Besançon. Notre programmation met à l'honneur des figures majeures de la scène classique et lyrique, ainsi que des étoiles montantes.
            </p>

            <img
                src="/icons/etoile3.svg"
                alt=""
                aria-hidden="true"
                class="absolute bottom-[-10px] right-2 hidden h-[86px] w-10 sm:block md:bottom-0 md:right-10 md:h-[112px] md:w-14"
            />
        </div>
    </section>

    <section class="pb-16">
        {
            representations.length > 0 ? (
                <div class="mx-auto grid w-full max-w-6xl gap-6 px-5 sm:px-6 md:grid-cols-2 md:px-10 lg:grid-cols-3">
                    {representations.map((representation) => (
                        <ArtisteCard
                            artiste={representation.expand?.artiste}
                            representation={representation}
                        />
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucun artiste n’est disponible pour le moment.
                </p>
            )
        }
    </section>
</Layout>
