---
import Layout from "../../layouts/Layout.astro";
import ArtisteCard from "../../components/ArtisteCard.astro";
import { getArtistesByDate } from "../../../backend/backend.mjs";

const representations = await getArtistesByDate();
---

<Layout title="Artistes - Chorus Symphonia">
    <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
        <h1 class="mb-4 text-6xl md:text-7xl">Artistes</h1>
        <p class="mx-auto max-w-2xl text-lg md:text-xl">
            Découvrez les artistes programmés au festival Chorus Symphonia,
            triés par date de représentation.
        </p>
    </section>

    <section class="pb-16">
        {
            representations.length > 0 ? (
                <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-2 lg:grid-cols-3">
                    {representations.map((representation) => (
                        <ArtisteCard
                            artiste={representation.expand?.artiste}
                            representation={representation}
                        />
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucun artiste n’est disponible pour le moment.
                </p>
            )
        }
    </section>
</Layout>
