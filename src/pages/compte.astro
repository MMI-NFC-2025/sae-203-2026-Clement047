---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mon compte - Chorus Symphonia" fullScreen={true}>
    <section class="relative isolate">
        <div class="relative h-[220px] sm:h-[280px] md:h-[360px]">
            <img
                src="/img/Acceuil/fondetoileacceuil.avif"
                alt="Fond étoilé"
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[var(--v-dark)] to-transparent md:h-32"></div>
        </div>
    </section>

    <section class="relative z-20 mx-auto w-full max-w-[1200px] px-5 pb-10 pt-0 sm:px-6 md:px-10 md:pb-14">
        <h1 class="-mt-10 text-[54px] leading-[0.9] text-[var(--light-v)] sm:-mt-12 sm:text-[68px] md:text-[88px]">
            Mon compte
        </h1>
    </section>

    <section class="mx-auto w-full max-w-[1200px] px-5 pb-16 sm:px-6 md:px-10 md:pb-24">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(300px,0.8fr)] lg:gap-16">
            <div>
                <p class="max-w-[46rem] text-[20px] leading-[1.45] text-[var(--light-v)]/92 sm:text-[24px] md:text-[32px]">
                    Cette page permet de saisir ou modifier automatiquement des données utilisateur depuis le front.
                </p>
            </div>

            <div class="border border-[var(--light-v)] bg-white/5 p-5 sm:p-6 md:p-8">
                <div id="accountStatus" class="mb-6 text-[16px] text-[var(--light-v)]/82 sm:text-[18px]"></div>

                <form id="accountForm" class="flex flex-col gap-4 md:gap-5">
                    <label class="sr-only" for="name">Nom affiché</label>
                    <input
                        id="name"
                        name="name"
                        type="text"
                        placeholder="Nom affiché"
                        class="w-full border border-transparent bg-[rgba(217,198,226,0.18)] px-4 py-3 text-[18px] text-[var(--light-v)] outline-none transition placeholder:text-[var(--light-v)]/72 focus:border-[var(--vi)] sm:text-[20px]"
                    />

                    <label class="sr-only" for="accountEmail">Adresse email</label>
                    <input
                        id="accountEmail"
                        name="email"
                        type="email"
                        autocomplete="email"
                        placeholder="Adresse email"
                        required
                        class="w-full border border-transparent bg-[rgba(217,198,226,0.18)] px-4 py-3 text-[18px] text-[var(--light-v)] outline-none transition placeholder:text-[var(--light-v)]/72 focus:border-[var(--vi)] sm:text-[20px]"
                    />

                    <button
                        type="submit"
                        class="mt-2 inline-flex min-h-[58px] items-center justify-center bg-[var(--yellow)] px-6 text-[18px] text-[var(--v-dark)] transition hover:opacity-90 sm:min-h-[64px] sm:text-[20px]"
                    >
                        Enregistrer les modifications
                    </button>
                </form>

                <button
                    id="logoutButton"
                    type="button"
                    class="mt-6 inline-flex min-h-[52px] items-center justify-center border border-[var(--light-v)] px-5 text-[17px] text-[var(--light-v)] transition hover:border-[var(--vi)] hover:text-white"
                >
                    Se déconnecter
                </button>

                <p id="accountFeedback" class="mt-4 min-h-[1.5rem] text-[16px] text-[var(--light-v)]/82"></p>
            </div>
        </div>
    </section>

    <script>
        import { getCurrentUser, getPocketBaseClient, isAuthenticated } from "../scripts/pocketbase-browser.js";

        const pb = getPocketBaseClient();
        const form = document.getElementById("accountForm");
        const nameInput = document.getElementById("name");
        const emailInput = document.getElementById("accountEmail");
        const feedback = document.getElementById("accountFeedback");
        const status = document.getElementById("accountStatus");
        const logoutButton = document.getElementById("logoutButton");

        const renderUser = () => {
            const user = getCurrentUser();

            if (!isAuthenticated() || !user) {
                window.location.href = "/connexion";
                return;
            }

            if (nameInput instanceof HTMLInputElement) {
                nameInput.value = user.name ?? "";
            }

            if (emailInput instanceof HTMLInputElement) {
                emailInput.value = user.email ?? "";
            }

            if (status) {
                status.textContent = `Connecté en tant que ${user.email}`;
            }
        };

        renderUser();

        form?.addEventListener("submit", async (event) => {
            event.preventDefault();

            const user = getCurrentUser();
            if (!user || !(form instanceof HTMLFormElement)) return;

            const formData = new FormData(form);
            const payload = {
                name: String(formData.get("name") ?? "").trim(),
                email: String(formData.get("email") ?? "").trim(),
            };

            if (feedback) {
                feedback.textContent = "Enregistrement en cours...";
            }

            try {
                const updatedUser = await pb.collection("users").update(user.id, payload);
                pb.authStore.save(pb.authStore.token, updatedUser);
                renderUser();

                if (feedback) {
                    feedback.textContent = "Vos informations ont bien été mises à jour.";
                }
            } catch (error) {
                if (feedback) {
                    feedback.textContent = "Impossible d’enregistrer les modifications.";
                }
                console.error(error);
            }
        });

        logoutButton?.addEventListener("click", () => {
            pb.authStore.clear();
            window.location.href = "/connexion";
        });
    </script>
</Layout>