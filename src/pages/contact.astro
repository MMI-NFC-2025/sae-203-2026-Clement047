---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact - Chorus Symphonia" fullScreen={true}>
    <section class="relative isolate">
        <div class="relative h-[42svh] min-h-[300px] md:h-[620px]">
            <img
                src="/img/Contact/imageherocontact.avif"
                alt="Ciel étoilé au-dessus des reliefs"
                class="absolute inset-0 h-full w-full object-cover"
            />
            <div
                class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[var(--v-dark)] to-transparent md:h-40"
            >
            </div>
        </div>
    </section>

    <section
        class="relative z-20 mx-auto w-full max-w-6xl -mt-[66px] overflow-visible px-5 pb-10 pt-0 sm:px-6 md:-mt-[82px] md:px-10 md:pb-14"
    >
        <h1
            class="text-[clamp(3.2rem,15vw,5.25rem)] font-normal leading-[0.9] text-[var(--light-v)]"
        >
            Contact
        </h1>
    </section>

    <section
        class="mx-auto w-full max-w-6xl px-5 pb-12 sm:px-6 md:px-10 md:pb-16"
    >
        <p
            class="max-w-[46rem] text-[18px] leading-[1.55] text-[var(--light-v)]/92 sm:text-[19px] md:max-w-[780px] md:text-[28px] md:leading-[1.5]"
        >
            Pour toute demande générale, veuillez utiliser le formulaire
            ci-dessous. Nous nous engageons à vous répondre dans les meilleurs
            délais.
        </p>
    </section>

    <section
        class="mx-auto w-full max-w-6xl px-5 pb-16 sm:px-6 md:px-10 md:pb-20"
    >
        <div class="w-full max-w-[46rem] md:max-w-[760px]">
            <p
                class="text-[14px] leading-[1.5] text-[var(--light-v)]/80 md:text-[18px]"
            >
                Les champs marqués d'un * sont obligatoires
            </p>

            <form
                id="contactForm"
                method="post"
                class="mt-8 flex flex-col gap-4 md:mt-10 md:gap-5"
            >
                <label class="sr-only" for="nom">Nom prénom *</label>
                <input
                    type="text"
                    id="nom"
                    name="nom"
                    placeholder="Nom prénom *"
                    required
                    class="w-full border-0 bg-[rgba(217,198,226,0.38)] px-4 py-3 text-[18px] text-[var(--light-v)] placeholder:text-[var(--light-v)]/78 outline-none md:px-5 md:py-4 md:text-[22px]"
                />

                <label class="sr-only" for="email">Adresse mail *</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Adresse mail *"
                    required
                    class="w-full border-0 bg-[rgba(217,198,226,0.38)] px-4 py-3 text-[18px] text-[var(--light-v)] placeholder:text-[var(--light-v)]/78 outline-none md:px-5 md:py-4 md:text-[22px]"
                />

                <label class="sr-only" for="sujet">Objet *</label>
                <input
                    type="text"
                    id="sujet"
                    name="sujet"
                    placeholder="Objet *"
                    required
                    class="w-full border-0 bg-[rgba(217,198,226,0.38)] px-4 py-3 text-[18px] text-[var(--light-v)] placeholder:text-[var(--light-v)]/78 outline-none md:px-5 md:py-4 md:text-[22px]"
                />

                <label class="sr-only" for="message">Votre message *</label>
                <textarea
                    id="message"
                    name="message"
                    rows="9"
                    placeholder="Votre message *"
                    required
                    class="min-h-[270px] w-full resize-none border-0 bg-[rgba(217,198,226,0.38)] px-4 py-4 text-[18px] text-[var(--light-v)] placeholder:text-[var(--light-v)]/78 outline-none md:min-h-[360px] md:px-5 md:py-5 md:text-[22px]"
                ></textarea>

                <button
                    type="submit"
                    class="mt-4 inline-flex min-h-[56px] items-center justify-center self-start bg-[var(--yellow)] px-7 text-[17px] leading-none text-[var(--v-dark)] transition hover:opacity-90 md:mt-6 md:min-h-[72px] md:px-10 md:text-[20px]"
                >
                    Envoyer
                </button>
            </form>

            <div
                class="mt-14 text-[18px] leading-[1.6] text-[var(--light-v)]/92 md:mt-16 md:text-[24px] md:leading-[1.65]"
            >
                <p class="font-semibold text-[var(--light-v)]">
                    Vous pouvez également nous contacter au :
                </p>

                <p class="mt-8">contact@chorussymphonia.fr</p>

                <p class="mt-8">03.13.45.85.95</p>

                <p class="mt-8">
                    Festival Chorus Symphonia Maison des Festivals 12, Rue de la
                    Musique 25000 Besançon, France
                </p>
            </div>
        </div>
    </section>

    <script>
        import { getCurrentUser, isAuthenticated } from "../scripts/pocketbase-browser.js";

        const form = document.getElementById("contactForm");

        if (isAuthenticated() && form) {
            const user = getCurrentUser();
            const nameField = form.querySelector("#nom");
            const emailField = form.querySelector("#email");

            if (user && nameField instanceof HTMLInputElement && !nameField.value) {
                nameField.value = user.name || user.email || "";
            }

            if (user && emailField instanceof HTMLInputElement && !emailField.value) {
                emailField.value = user.email || "";
            }
        }
    </script>
</Layout>
