---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact - Chorus Symphonia">
    <section class="page-hero page-hero--small">
        <h1 class="page-hero__title">Contact</h1>
        <p class="page-hero__intro">
            Une question sur le festival, la programmation ou l’accès au site ?
            Contactez-nous via le formulaire ci-dessous.
        </p>
    </section>

    <section class="contact-page">
        <div class="contact-page__content">
            <h2 class="contact-page__title">Nous écrire</h2>

            <form class="contact-form" method="post">
                <div class="contact-form__group">
                    <label for="nom" class="contact-form__label">Nom</label>
                    <input
                        type="text"
                        id="nom"
                        name="nom"
                        class="contact-form__input"
                        required
                    />
                </div>

                <div class="contact-form__group">
                    <label for="email" class="contact-form__label">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="contact-form__input"
                        required
                    />
                </div>

                <div class="contact-form__group">
                    <label for="sujet" class="contact-form__label">Sujet</label>
                    <input
                        type="text"
                        id="sujet"
                        name="sujet"
                        class="contact-form__input"
                        required
                    />
                </div>

                <div class="contact-form__group">
                    <label for="message" class="contact-form__label"
                        >Message</label
                    >
                    <textarea
                        id="message"
                        name="message"
                        class="contact-form__textarea"
                        rows="6"
                        required></textarea>
                </div>

                <button type="submit" class="contact-form__button">
                    Envoyer
                </button>
            </form>
        </div>

        <aside class="contact-page__infos">
            <h2 class="contact-page__title">Informations utiles</h2>

            <p class="contact-page__text">
                <strong>Email :</strong> contact@chorussymphonia.fr
            </p>

            <p class="contact-page__text">
                <strong>Téléphone :</strong> 03 81 00 00 00
            </p>

            <p class="contact-page__text">
                <strong>Adresse :</strong><br />
                Citadelle de Besançon<br />
                99 Rue des Fusillés de la Résistance<br />
                25000 Besançon
            </p>
        </aside>
    </section>
</Layout>
