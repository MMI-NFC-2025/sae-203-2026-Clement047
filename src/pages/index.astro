---
import Layout from "../layouts/Layout.astro";
import FloatingLabelCard from "../components/FloatingLabelCard.astro";
---

<Layout title="Accueil - Chorus Symphonia" fullScreen={true}>
	<section id="hero" class="relative isolate min-h-screen overflow-hidden">
		<img
			src="/img/Acceuil/fondetoileacceuil.avif"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 z-0 h-full w-full object-cover object-center"
			loading="eager"
			decoding="async"
		/>

		<!-- Dégradé fondu en haut -->
		<div
			class="absolute inset-x-0 top-0 z-[1] h-40 bg-gradient-to-b from-[var(--v-dark)] to-transparent"
		>
		</div>

		<!-- Dégradé fondu en bas -->
		<div
			class="absolute inset-x-0 bottom-0 z-[1] h-48 bg-gradient-to-t from-[var(--v-dark)] to-transparent"
		>
		</div>

		<!-- Contenu centré -->
		<div
			class="relative z-10 flex min-h-screen flex-col items-center justify-end px-4 pb-[15vh]"
		>
			<div class="flex flex-col items-center w-[95vw] max-w-[700px]">
				<img
					src="/icons/logofestival.svg"
					alt="Logo Chorus Symphonia"
					class="w-full h-auto"
				/>

				<p
					class="-mt-2 text-center text-[32px] md:text-[48px] font-normal font-[Mohave] tracking-normal text-[var(--light-v)]"
				>
					28 - 31 août 2026
				</p>
			</div>
		</div>

		<!-- Étoile en bas à droite -->
		<img
			src="/icons/etoile3.svg"
			alt=""
			aria-hidden="true"
			class="absolute bottom-6 right-8 z-10 w-12 h-[91px] md:w-16 md:h-[91px] md:bottom-8 md:right-12"
		/>
	</section>

	<!-- ...existing code... -->
	<section
		class="mx-auto w-full max-w-6xl px-5 pb-8 pt-10 sm:px-6 md:px-10 md:pb-10 md:pt-16"
	>
		<h1
			class="max-w-[18rem] text-left text-[clamp(2.9rem,13vw,4rem)] leading-[0.98] font-normal text-[var(--light-v)] sm:max-w-[24rem] md:max-w-[350px] md:text-[64px] md:leading-[68px]"
		>
			Festival
			<br />
			de <span class="text-[var(--vi)]">musique</span>
			<br />
			<span class="text-[var(--vi)]">classique</span>
			<br />
			à la <span class="text-[var(--vi)]">Citadelle</span>
			<br />
			de <span class="text-[var(--vi)]">Besançon</span>
		</h1>
	</section>

	<section
		class="flex flex-wrap items-center justify-center gap-5 px-5 pb-14 sm:px-6 md:justify-start md:gap-10 md:px-10 md:pb-16"
	>
		<img
			src="/icons/etoile1.svg"
			alt=""
			aria-hidden="true"
			class="h-10 w-10 shrink-0"
		/>
		<a
			href="#"
			class="inline-block transition duration-200 hover:opacity-90"
		>
			<img
				src="/icons/cta.svg"
				alt="Je prends mon billet !"
				class="h-auto w-[212px]"
			/>
		</a>
		<img
			src="/icons/etoile2.svg"
			alt=""
			aria-hidden="true"
			class="h-10 w-10 shrink-0"
		/>
	</section>

	<section
		aria-label="Accès rapides"
		class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-10 px-5 pb-16 sm:px-6 md:grid-cols-2 md:gap-x-10 md:gap-y-12 md:px-10 lg:grid-cols-3"
	>
		<FloatingLabelCard
			href="/programme"
			imageSrc="/img/Acceuil/vitrineprogrammeacceuil.avif"
			imageAlt="Aller à la page Programme"
			label="Programme"
			aspectClass="aspect-[344/156]"
			labelAlign="end"
			labelWidthClass="w-[244px] justify-center"
		/>

		<FloatingLabelCard
			href="/artistes"
			imageSrc="/img/Acceuil/vitrineartistesacceuil.avif"
			imageAlt="Aller à la page Artistes"
			label="Artistes"
			aspectClass="aspect-[344/156]"
			labelAlign="end"
			labelWidthClass="w-[244px] justify-center"
		/>

		<FloatingLabelCard
			href="/infos-pratiques"
			imageSrc="/img/Acceuil/vitrineinformationsacceuil.avif"
			imageAlt="Aller à la page Informations pratiques"
			label="Informations"
			aspectClass="aspect-[344/156]"
			labelAlign="end"
			labelWidthClass="w-[244px] justify-center"
		/>
	</section>

	<section
		class="mx-auto w-full max-w-6xl px-5 pb-0 pt-8 sm:px-6 md:px-10 md:pt-16"
	>
		<div class="flex items-center gap-4 md:gap-5">
			<img
				src="/icons/etoile1.svg"
				alt=""
				aria-hidden="true"
				class="h-10 w-10 shrink-0"
			/>
			<h2
				class="text-[28px] font-bold leading-none text-[var(--yellow)] md:text-[42px]"
			>
				Nos partenaires
			</h2>
		</div>

		<div
			class="grid grid-cols-1 items-center gap-12 px-2 py-16 sm:grid-cols-2 md:grid-cols-3 md:gap-12 md:px-0 md:py-20"
		>
			<img
				src="/icons/logocitadelle1.svg"
				alt="Logo de la Citadelle de Besançon"
				class="h-auto w-[150px] md:w-[220px]"
			/>
			<img
				src="/icons/artelogo1.svg"
				alt="Logo Arte"
				class="h-auto w-[150px] md:w-[190px]"
			/>
			<img
				src="/icons/estrepublicainlogo1.svg"
				alt="Logo L'Est Républicain"
				class="h-auto w-[150px] md:w-[190px]"
			/>
		</div>

		<div class="h-[4px] w-full bg-[var(--dark)]/90"></div>
	</section>
</Layout>
