---
import Layout from "../../layouts/Layout.astro";
import { getArtistesByDate } from "../../../backend/backend.mjs";

const { jour } = Astro.params;
const representations = await getArtistesByDate();

const getJourKey = (value) => {
    if (!value) return "";

    const date = new Date(value);

    const parts = new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    }).formatToParts(date);

    const year = parts.find((p) => p.type === "year")?.value;
    const month = parts.find((p) => p.type === "month")?.value;
    const day = parts.find((p) => p.type === "day")?.value;

    return `${year}-${month}-${day}`;
};

const formatDateLabel = (value) => {
    if (!value) return "";

    return new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(new Date(value));
};

const programmesFiltres = representations.filter((rep) => {
    return getJourKey(rep.date_representation) === jour;
});
---

<Layout title={`Programme du ${formatDateLabel(jour)} - Chorus Symphonia`}>
    <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
        <h1 class="mb-4 text-5xl md:text-7xl">
            Programme du {formatDateLabel(jour)}
        </h1>
        <p class="mx-auto max-w-2xl text-lg md:text-xl">
            Représentations prévues à cette date.
        </p>
    </section>

    <section class="pb-16">
        {
            programmesFiltres.length > 0 ? (
                <div class="mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-2 lg:grid-cols-3">
                    {programmesFiltres.map((rep) => (
                        <article class="border border-[var(--light-v)] bg-white/5 p-5">
                            <p class="mb-3 text-sm md:text-base">
                                <strong>
                                    {formatDateLabel(rep.date_representation)}
                                </strong>
                                {rep.heure_representation
                                    ? ` • ${rep.heure_representation}`
                                    : ""}
                            </p>

                            <h2 class="mb-3 text-4xl leading-none md:text-5xl">
                                <a
                                    href={`/artistes/${rep.expand?.artiste?.id}`}
                                >
                                    {rep.expand?.artiste?.nom ?? "Artiste"}
                                </a>
                            </h2>

                            <p class="mb-2">
                                {rep.expand?.scene?.nom ??
                                    "Scène non renseignée"}
                            </p>

                            <p class="text-sm md:text-base">
                                {rep.expand?.artiste?.genre_musical ??
                                    "Genre non renseigné"}
                            </p>
                        </article>
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucune représentation n’est prévue à cette date.
                </p>
            )
        }

        <div class="mx-auto mt-8 max-w-6xl px-6">
            <a
                href="/programme"
                class="inline-block border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
            >
                ← Retour au programme complet
            </a>
        </div>
    </section>
</Layout>
