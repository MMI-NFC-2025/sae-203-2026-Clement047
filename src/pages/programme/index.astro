---
import Layout from "../../layouts/Layout.astro";
import { getArtistesByDate } from "../../../backend/backend.mjs";

const representations = await getArtistesByDate();

const getJourKey = (value) => {
    if (!value) return "";

    const date = new Date(value);

    const parts = new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    }).formatToParts(date);

    const year = parts.find((p) => p.type === "year")?.value;
    const month = parts.find((p) => p.type === "month")?.value;
    const day = parts.find((p) => p.type === "day")?.value;

    return `${year}-${month}-${day}`;
};

const formatDateLabel = (value) => {
    if (!value) return "";

    return new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(new Date(value));
};

const uniqueDates = [
    ...new Set(
        representations
            .map((rep) => getJourKey(rep.date_representation))
            .filter(Boolean),
    ),
];

const uniqueScenes = [
    ...new Set(
        representations.map((rep) => rep.expand?.scene?.nom).filter(Boolean),
    ),
];

const uniqueGenres = [
    ...new Set(
        representations
            .map((rep) => rep.expand?.artiste?.genre_musical)
            .filter(Boolean),
    ),
];
---

<Layout title="Programme - Chorus Symphonia">
    <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
        <h1 class="mb-4 text-6xl md:text-7xl">Programme</h1>
        <p class="mx-auto max-w-2xl text-lg md:text-xl">
            Découvrez la programmation du festival et filtrez les
            représentations par jour, par scène ou par genre.
        </p>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-8">
        <div class="mb-8">
            <h2 class="mb-4 text-3xl md:text-4xl">Filtrer par jour</h2>
            <div class="flex flex-wrap gap-3">
                <button
                    class="filter-btn filter-date active border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                    data-date="all"
                >
                    Tous les jours
                </button>

                {
                    uniqueDates.map((date) => (
                        <button
                            class="filter-btn filter-date border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                            data-date={date}
                        >
                            {formatDateLabel(date)}
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="mb-8">
            <h2 class="mb-4 text-3xl md:text-4xl">Filtrer par scène</h2>
            <div class="flex flex-wrap gap-3">
                <button
                    class="filter-btn filter-scene active border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                    data-scene="all"
                >
                    Toutes les scènes
                </button>

                {
                    uniqueScenes.map((scene) => (
                        <button
                            class="filter-btn filter-scene border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                            data-scene={scene}
                        >
                            {scene}
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="mb-8">
            <h2 class="mb-4 text-3xl md:text-4xl">Filtrer par genre</h2>
            <div class="flex flex-wrap gap-3">
                <button
                    class="filter-btn filter-genre active border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                    data-genre="all"
                >
                    Tous les genres
                </button>

                {
                    uniqueGenres.map((genre) => (
                        <button
                            class="filter-btn filter-genre border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                            data-genre={genre}
                        >
                            {genre}
                        </button>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="pb-16">
        {
            representations.length > 0 ? (
                <div class="mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-2 lg:grid-cols-3">
                    {representations.map((rep) => (
                        <article
                            class="programme-item event-section border border-[var(--light-v)] bg-white/5 p-5"
                            data-date={getJourKey(rep.date_representation)}
                            data-scene={rep.expand?.scene?.nom}
                            data-genre={rep.expand?.artiste?.genre_musical}
                        >
                            <p class="mb-3 text-sm md:text-base">
                                <strong>
                                    {formatDateLabel(rep.date_representation)}
                                </strong>
                                {rep.heure_representation
                                    ? ` • ${rep.heure_representation}`
                                    : ""}
                            </p>

                            <h2 class="mb-3 text-4xl leading-none md:text-5xl">
                                <a
                                    href={`/artistes/${rep.expand?.artiste?.id}`}
                                >
                                    {rep.expand?.artiste?.nom ?? "Artiste"}
                                </a>
                            </h2>

                            <p class="mb-2">
                                {rep.expand?.scene?.nom ??
                                    "Scène non renseignée"}
                            </p>

                            <p class="text-sm md:text-base">
                                {rep.expand?.artiste?.genre_musical ??
                                    "Genre non renseigné"}
                            </p>
                        </article>
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucune représentation n’est disponible pour le moment.
                </p>
            )
        }
    </section>

    <script>
        import "../../scripts/programme-filters.js";
    </script>
</Layout>
