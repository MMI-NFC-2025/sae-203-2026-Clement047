---
import Layout from "../../layouts/Layout.astro";
import FloatingLabelCard from "../../components/FloatingLabelCard.astro";
import { getArtistesByDate } from "../../../backend/backend.mjs";

const representations = await getArtistesByDate();

const getJourKey = (value: string | Date | null | undefined) => {
    if (!value) return "";

    const date = new Date(value);

    const parts = new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    }).formatToParts(date);

    const year = parts.find((p) => p.type === "year")?.value;
    const month = parts.find((p) => p.type === "month")?.value;
    const day = parts.find((p) => p.type === "day")?.value;

    return `${year}-${month}-${day}`;
};

const formatDateLabel = (value: string | Date | null | undefined) => {
    if (!value) return "";

    return new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(new Date(value));
};

const uniqueDates = [
    ...new Set(
        representations
            .map((rep) => getJourKey(rep.date_representation))
            .filter(Boolean),
    ),
];

const uniqueScenes = [
    ...new Set(
        representations.map((rep) => rep.expand?.scene?.nom).filter(Boolean),
    ),
];

const uniqueGenres = [
    ...new Set(
        representations
            .map((rep) => rep.expand?.artiste?.genre_musical)
            .filter(Boolean),
    ),
];
---

<Layout title="Programme - Chorus Symphonia" fullScreen={true}>
    <section class="relative isolate overflow-hidden">
        <div class="relative h-[42svh] min-h-[300px] md:h-[470px] xl:h-[560px]">
            <img
                src="/img/Programme/imageconcertprogramme.avif"
                alt="Concert du festival éclairé en bleu et violet"
                class="absolute inset-0 h-full w-full object-cover object-center"
            />
            <div
                class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-[var(--v-dark)]/88 via-[var(--v-dark)]/48 to-transparent md:h-32"
            >
            </div>
            <div
                class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[var(--v-dark)] via-[var(--v-dark)]/86 to-transparent md:h-28 xl:h-32"
            >
            </div>
        </div>
    </section>

    <section
        class="relative z-20 mx-auto w-full max-w-6xl -mt-[102px] bg-[var(--v-dark)] px-5 pb-10 pt-0 sm:px-6 md:mt-0 md:px-10 md:pb-14 md:pt-10 xl:pt-12"
    >
        <h1
            class="relative z-10 max-w-[26rem] text-[clamp(3.2rem,15vw,5.25rem)] font-normal leading-[0.9] text-[var(--light-v)]"
        >
            Programme
        </h1>

        <h2
            class="relative z-10 max-w-[22rem] pt-12 text-[clamp(1.9rem,10vw,4rem)] font-normal leading-[1.02] text-[var(--vi)] sm:max-w-[34rem] md:max-w-[720px] md:pt-8 md:leading-[58px] xl:pt-10 xl:leading-[68px]"
        >
            Quatre jours d'émotion à la
            <br />
            Citadelle
        </h2>
    </section>

    <section
        class="mx-auto w-full max-w-6xl px-5 pb-10 sm:px-6 md:px-10 md:pb-14"
    >
        <div class="relative md:max-w-[860px]">
            <p
                class="max-w-[44rem] text-[18px] leading-[1.55] text-[var(--light-v)]/92 sm:text-[19px] md:max-w-[760px] md:text-[28px] md:leading-[1.5]"
            >
                <span class="text-[var(--vi)]"
                    >Du jeudi 28 au dimanche 31 août</span
                >, la Citadelle de Besançon se transforme en un écrin vibrant
                pour la musique classique et lyrique. Notre programmation est
                conçue pour être une symphonie d'expériences, mêlant les grandes
                oeuvres du répertoire à des moments de partage et de découverte.
            </p>

            <img
                src="/icons/etoile3.svg"
                alt=""
                aria-hidden="true"
                class="absolute bottom-0 right-8 hidden h-[86px] w-10 sm:block md:right-10 md:h-[112px] md:w-14"
            />
        </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-5 pb-8 sm:px-6 md:px-10">
        <div class="mb-8">
            <h2 class="mb-4 text-2xl sm:text-3xl md:text-4xl">
                Filtrer par jour
            </h2>
            <div class="flex flex-wrap gap-3">
                <button
                    class="filter-btn filter-date active border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                    data-date="all"
                >
                    Tous les jours
                </button>

                {
                    uniqueDates.map((date) => (
                        <button
                            class="filter-btn filter-date border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                            data-date={date}
                        >
                            {formatDateLabel(date)}
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="mb-8">
            <h2 class="mb-4 text-2xl sm:text-3xl md:text-4xl">
                Filtrer par scène
            </h2>
            <div class="flex flex-wrap gap-3">
                <button
                    class="filter-btn filter-scene active border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                    data-scene="all"
                >
                    Toutes les scènes
                </button>

                {
                    uniqueScenes.map((scene) => (
                        <button
                            class="filter-btn filter-scene border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                            data-scene={scene}
                        >
                            {scene}
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="mb-8">
            <h2 class="mb-4 text-2xl sm:text-3xl md:text-4xl">
                Filtrer par genre
            </h2>
            <div class="flex flex-wrap gap-3">
                <button
                    class="filter-btn filter-genre active border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                    data-genre="all"
                >
                    Tous les genres
                </button>

                {
                    uniqueGenres.map((genre) => (
                        <button
                            class="filter-btn filter-genre border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                            data-genre={genre}
                        >
                            {genre}
                        </button>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="pb-16">
        {
            representations.length > 0 ? (
                <div class="mx-auto grid w-full max-w-6xl gap-6 px-5 sm:px-6 md:grid-cols-2 md:px-10 lg:grid-cols-3">
                    {representations.map((rep) => (
                        <article
                            class="programme-item event-section group relative overflow-hidden border border-[var(--light-v)]/90 bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.015))] px-6 py-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--vi)] hover:shadow-[0_22px_50px_rgba(0,0,0,0.28)] md:px-7 md:py-7"
                            data-date={getJourKey(rep.date_representation)}
                            data-scene={rep.expand?.scene?.nom}
                            data-genre={rep.expand?.artiste?.genre_musical}
                        >
                            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(142,77,228,0.12),transparent_42%)] opacity-80" />
                            <div class="relative flex min-h-[180px] flex-col sm:min-h-[214px]">
                                <p class="mb-5 text-[15px] font-semibold leading-none text-[var(--light-v)] md:text-[17px]">
                                    {formatDateLabel(rep.date_representation)}
                                    {rep.heure_representation
                                        ? ` • ${rep.heure_representation}`
                                        : ""}
                                </p>

                                <h2 class="mb-5 text-[clamp(2.5rem,12vw,3.625rem)] leading-[0.9] tracking-[-0.02em] text-[var(--light-v)]">
                                    <a
                                        href={`/artistes/${rep.expand?.artiste?.id}`}
                                        class="transition group-hover:text-white"
                                    >
                                        {rep.expand?.artiste?.nom ?? "Artiste"}
                                    </a>
                                </h2>

                                <div class="mt-auto space-y-3">
                                    <p class="text-[18px] leading-[1.2] text-[var(--light-v)] md:text-[20px]">
                                        {rep.expand?.scene?.nom ??
                                            "Scène non renseignée"}
                                    </p>

                                    <p class="text-[18px] leading-none text-[var(--light-v)]/88 md:text-[20px]">
                                        {rep.expand?.artiste?.genre_musical ??
                                            "Genre non renseigné"}
                                    </p>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucune représentation n’est disponible pour le moment.
                </p>
            )
        }
    </section>

    <section
        class="mx-auto flex w-full max-w-6xl flex-col items-center px-5 pb-12 pt-4 sm:px-6 md:pb-16 md:pt-6 md:px-10"
    >
        <div class="flex w-full flex-col items-center gap-8 md:gap-10">
            <a
                href="#"
                class="inline-block transition duration-200 hover:opacity-90"
            >
                <img
                    src="/icons/cta.svg"
                    alt="Je prends mon billet !"
                    class="h-auto w-[212px] md:w-[260px]"
                />
            </a>

            <a
                href="#"
                class="inline-block transition duration-200 hover:opacity-90"
            >
                <img
                    src="/icons/pdf.svg"
                    alt="Je télécharge le PDF !"
                    class="h-auto w-[212px] md:w-[260px]"
                />
            </a>
        </div>
    </section>

    <section
        class="mx-auto w-full max-w-6xl px-5 pb-20 sm:px-6 md:px-10 md:pb-24"
    >
        <FloatingLabelCard
            href="/scenes"
            imageSrc="/img/Programme/vitrinescenesprogramme.avif"
            imageAlt="Aller à la page Les scènes"
            label="Les scènes"
            aspectClass="aspect-[344/156]"
            labelAlign="end"
            labelWidthClass="w-[310px] justify-center md:w-[340px]"
        />
    </section>

    <script>
        import "../../scripts/programme-filters.js";
    </script>
</Layout>
