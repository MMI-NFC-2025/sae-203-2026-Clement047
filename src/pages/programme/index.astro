---
import Layout from "../../layouts/Layout.astro";
import { getArtistesByDate } from "../../../backend/backend.mjs";

const representations = await getArtistesByDate();

const getJourKey = (value) => {
    if (!value) return "";

    const date = new Date(value);

    const parts = new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    }).formatToParts(date);

    const year = parts.find((p) => p.type === "year")?.value;
    const month = parts.find((p) => p.type === "month")?.value;
    const day = parts.find((p) => p.type === "day")?.value;

    return `${year}-${month}-${day}`;
};

const formatDateLabel = (value) => {
    if (!value) return "";

    return new Intl.DateTimeFormat("fr-FR", {
        timeZone: "Europe/Paris",
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(new Date(value));
};

const uniqueDates = [
    ...new Set(
        representations
            .map((rep) => getJourKey(rep.date_representation))
            .filter(Boolean),
    ),
];

const uniqueScenes = [
    ...new Set(
        representations.map((rep) => rep.expand?.scene?.nom).filter(Boolean),
    ),
];
---

<Layout title="Programme - Chorus Symphonia">
    <section class="page-hero page-hero--small">
        <h1 class="page-hero__title">Programme</h1>
        <p class="page-hero__intro">
            Découvrez la programmation du festival et filtrez les
            représentations par jour ou par scène.
        </p>
    </section>

    <section class="filters">
        <div class="filters__group">
            <h2 class="filters__title">Filtrer par jour</h2>
            <div class="filters__buttons">
                <button class="filter-btn filter-date active" data-date="all">
                    Tous les jours
                </button>

                {
                    uniqueDates.map((date) => (
                        <button class="filter-btn filter-date" data-date={date}>
                            {formatDateLabel(date)}
                        </button>
                    ))
                }
            </div>
        </div>

        <div class="filters__group">
            <h2 class="filters__title">Filtrer par scène</h2>
            <div class="filters__buttons">
                <button class="filter-btn filter-scene active" data-scene="all">
                    Toutes les scènes
                </button>

                {
                    uniqueScenes.map((scene) => (
                        <button
                            class="filter-btn filter-scene"
                            data-scene={scene}
                        >
                            {scene}
                        </button>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="programme-days-links">
        <h2 class="filters__title">Accès direct par jour</h2>
        <div class="filters__buttons">
            {
                uniqueDates.map((date) => (
                    <a href={`/programme/${date}`} class="filter-btn">
                        {formatDateLabel(date)}
                    </a>
                ))
            }
        </div>
    </section>

    <section class="programme-list">
        {
            representations.length > 0 ? (
                <div class="programme-list__items">
                    {representations.map((rep) => (
                        <article
                            class="programme-item event-section"
                            data-date={getJourKey(rep.date_representation)}
                            data-scene={rep.expand?.scene?.nom}
                        >
                            <p class="programme-item__date">
                                <strong>
                                    {formatDateLabel(rep.date_representation)}
                                </strong>
                                {rep.heure_representation
                                    ? ` • ${rep.heure_representation}`
                                    : ""}
                            </p>

                            <h2 class="programme-item__title">
                                <a
                                    href={`/artistes/${rep.expand?.artiste?.id}`}
                                >
                                    {rep.expand?.artiste?.nom ?? "Artiste"}
                                </a>
                            </h2>

                            <p class="programme-item__meta">
                                {rep.expand?.scene?.nom ??
                                    "Scène non renseignée"}
                            </p>

                            <p class="programme-item__genre">
                                {rep.expand?.artiste?.genre_musical ??
                                    "Genre non renseigné"}
                            </p>
                        </article>
                    ))}
                </div>
            ) : (
                <p class="programme-list__empty">
                    Aucune représentation n’est disponible pour le moment.
                </p>
            )
        }
    </section>

    <script>
        import "../../scripts/programme-filters.js";
    </script>
</Layout>
