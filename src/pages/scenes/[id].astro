---
import Layout from "../../layouts/Layout.astro";
import {
    getSceneById,
    getArtistesBySceneId,
    getImageUrl,
} from "../../../backend/backend.mjs";

const { id } = Astro.params;

const scene = await getSceneById(id);
const representations = await getArtistesBySceneId(id);

const photo = scene?.photo ?? null;
---

<Layout title={`${scene?.nom ?? "Scène"} - Chorus Symphonia`}>
    {
        scene ? (
            <>
                <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
                    <h1 class="mb-4 text-5xl md:text-7xl">{scene.nom}</h1>
                    <p class="mx-auto max-w-2xl text-lg md:text-xl">
                        {scene.localisation ?? "Localisation non renseignée"}
                    </p>
                </section>

                <section class="mx-auto grid max-w-6xl gap-8 px-6 pb-12 md:grid-cols-2">
                    <div>
                        {photo ? (
                            <img
                                src={getImageUrl(scene, photo)}
                                alt={`Photo de ${scene.nom}`}
                                class="aspect-[4/3] w-full border border-[var(--light-v)] object-cover"
                            />
                        ) : (
                            <div class="flex aspect-[4/3] w-full items-center justify-center border border-[var(--light-v)] bg-white/5 text-center">
                                Aucune image disponible
                            </div>
                        )}
                    </div>

                    <div>
                        <h2 class="mb-4 text-4xl md:text-5xl">Présentation</h2>

                        <div
                            class="mb-6 space-y-4"
                            set:html={
                                scene.description ??
                                "<p>Aucune description disponible.</p>"
                            }
                        />

                        <p class="mb-8">
                            <strong>Capacité :</strong>
                            {scene.capacite ?? "Non renseignée"}
                        </p>

                        <h2 class="mb-4 text-4xl md:text-5xl">
                            Artistes programmés
                        </h2>

                        {representations.length > 0 ? (
                            <ul class="mb-8 list-disc space-y-3 pl-5">
                                {representations.map((rep) => (
                                    <li>
                                        <a
                                            href={`/artistes/${rep.expand?.artiste?.id}`}
                                            class="underline"
                                        >
                                            {rep.expand?.artiste?.nom ??
                                                "Artiste"}
                                        </a>
                                        {" • "}
                                        {rep.date_representation
                                            ?.slice(0, 10)
                                            .split("-")
                                            .reverse()
                                            .join("/")}
                                        {rep.heure_representation
                                            ? ` • ${rep.heure_representation}`
                                            : ""}
                                    </li>
                                ))}
                            </ul>
                        ) : (
                            <p class="mb-8">
                                Aucun artiste n’est programmé sur cette scène.
                            </p>
                        )}

                        <a
                            href="/scenes"
                            class="inline-block border border-[var(--light-v)] px-4 py-3 transition hover:bg-[var(--vi)]"
                        >
                            ← Retour aux scènes
                        </a>
                    </div>
                </section>
            </>
        ) : (
            <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
                <h1 class="mb-4 text-5xl md:text-7xl">Scène introuvable</h1>
                <p class="mx-auto max-w-2xl text-lg md:text-xl">
                    Cette scène n’existe pas ou n’est plus disponible.
                </p>
            </section>
        )
    }
</Layout>
