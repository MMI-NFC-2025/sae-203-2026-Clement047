---
import Layout from "../../layouts/Layout.astro";
import SceneCard from "../../components/SceneCard.astro";
import { getScenesByName } from "../../../backend/backend.mjs";

const scenes = await getScenesByName();
---

<Layout title="Scènes - Chorus Symphonia" fullScreen={true}>
    <section class="relative isolate overflow-hidden">
        <div class="relative h-[42svh] min-h-[300px] md:h-[470px] xl:h-[560px]">
            <img
                src="/img/Scenes/imageheroscènes.avif"
                alt="Vue nocturne des lieux du festival"
                class="absolute inset-0 h-full w-full object-cover object-center"
            />
            <div
                class="absolute inset-0 bg-gradient-to-b from-[var(--v-dark)]/72 via-transparent to-transparent"
            >
            </div>
            <div
                class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[var(--v-dark)] via-[var(--v-dark)]/88 to-transparent md:h-44"
            >
            </div>
        </div>
    </section>

    <section
        class="relative z-20 mx-auto w-full max-w-6xl -mt-[66px] overflow-visible bg-[var(--v-dark)] px-5 pb-10 pt-0 sm:px-6 md:mt-0 md:px-10 md:pb-14 md:pt-10 xl:pt-12"
    >
        <p
            class="mb-4 inline-flex border border-[var(--light-v)]/35 bg-white/5 px-3 py-2 text-[11px] uppercase tracking-[0.34em] text-[var(--light-v)]/72 md:mb-6 md:text-[12px]"
        >
            Les lieux du festival
        </p>

        <h1
            class="text-[clamp(3.2rem,15vw,5.25rem)] font-normal leading-[0.9] text-[var(--light-v)]"
        >
            Scènes
        </h1>

        <h2
            class="max-w-[22rem] pt-16 text-[clamp(2rem,10vw,3.75rem)] font-normal leading-[1.02] text-[var(--vi)] sm:max-w-[34rem] md:max-w-[760px] md:pt-10 md:leading-[56px] xl:pt-12 xl:leading-[64px]"
        >
            Un Écrin pour Chaque Note
        </h2>
    </section>

    <section
        class="mx-auto w-full max-w-6xl px-5 pb-12 sm:px-6 md:px-10 md:pb-16"
    >
        <div class="relative md:max-w-[860px]">
            <p
                class="max-w-[44rem] text-[18px] leading-[1.55] text-[var(--light-v)]/92 sm:text-[19px] md:max-w-[760px] md:text-[28px] md:leading-[1.5]"
            >
                Le Festival Chorus Symphonia se déploie sur plusieurs lieux
                emblématiques au sein de la Citadelle de Besançon, chacun
                offrant une ambiance et une acoustique uniques.
            </p>

            <img
                src="/icons/etoile3.svg"
                alt=""
                aria-hidden="true"
                class="absolute bottom-[-10px] right-2 hidden h-[86px] w-10 sm:block md:bottom-0 md:right-10 md:h-[112px] md:w-14"
            />
        </div>
    </section>

    <section class="pb-16">
        {
            scenes.length > 0 ? (
                <div class="mx-auto grid w-full max-w-6xl gap-6 px-5 sm:px-6 md:grid-cols-2 md:px-10 lg:grid-cols-3">
                    {scenes.map((scene) => (
                        <SceneCard scene={scene} />
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucune scène n’est disponible pour le moment.
                </p>
            )
        }
    </section>
</Layout>
