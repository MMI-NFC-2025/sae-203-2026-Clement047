---
import Layout from "../../layouts/Layout.astro";
import SceneCard from "../../components/SceneCard.astro";
import { getScenesByName } from "../../../backend/backend.mjs";

const scenes = await getScenesByName();
---

<Layout title="Scènes - Chorus Symphonia">
    <section class="mx-auto w-full max-w-6xl px-5 pb-8 pt-28 text-center sm:px-6 md:px-10 md:pt-32">
        <h1 class="mb-4 text-[clamp(3rem,14vw,4.5rem)]">Scènes</h1>
        <p class="mx-auto max-w-2xl text-base sm:text-lg md:text-xl">
            Découvrez les différents espaces du festival Chorus Symphonia.
        </p>
    </section>

    <section class="pb-16">
        {
            scenes.length > 0 ? (
                <div class="mx-auto grid w-full max-w-6xl gap-6 px-5 sm:px-6 md:grid-cols-2 md:px-10 lg:grid-cols-3">
                    {scenes.map((scene) => (
                        <SceneCard scene={scene} />
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucune scène n’est disponible pour le moment.
                </p>
            )
        }
    </section>
</Layout>
