---
import Layout from "../../layouts/Layout.astro";
import SceneCard from "../../components/SceneCard.astro";
import { getScenesByName } from "../../../backend/backend.mjs";

const scenes = await getScenesByName();
---

<Layout title="Scènes - Chorus Symphonia">
    <section class="mx-auto max-w-4xl px-6 pb-8 pt-32 text-center">
        <h1 class="mb-4 text-6xl md:text-7xl">Scènes</h1>
        <p class="mx-auto max-w-2xl text-lg md:text-xl">
            Découvrez les différents espaces du festival Chorus Symphonia.
        </p>
    </section>

    <section class="pb-16">
        {
            scenes.length > 0 ? (
                <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-2 lg:grid-cols-3">
                    {scenes.map((scene) => (
                        <SceneCard scene={scene} />
                    ))}
                </div>
            ) : (
                <p class="px-6 text-center">
                    Aucune scène n’est disponible pour le moment.
                </p>
            )
        }
    </section>
</Layout>
